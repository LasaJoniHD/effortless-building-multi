+        long until = System.currentTimeMillis() + Long.getLong("probe.duration", modded ? 5000L : 30_000L);
+        while (System.currentTimeMillis() < until) {
+            tick();
+            check();
+            if (!modded) vanillaActions();
+            Thread.sleep(25);
+        }
+        finished = true;
+        connection.disconnect(Component.literal("Probe complete"));
+        System.out.println("PROBE PASS " + name + ": " + packets + " vanilla-decoded packets, payloads=" + payloads);
+    }
