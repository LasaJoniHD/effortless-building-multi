+        BackendProtocolProbe probe = new BackendProtocolProbe(modded);
+        try {
+            probe.run();
+            if (vanilla != null && vanilla.waitFor() != 0) throw new AssertionError("Vanilla connection probe failed");
+        } catch (Throwable failure) {
