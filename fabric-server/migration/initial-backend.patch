+package nl.requios.effortlessbuilding.network;
+
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import nl.requios.effortlessbuilding.Constants;
+
+/** Optional play-phase opt-in, also echoed by the server as acknowledgement. */
+public record BackendHelloPacket(int version) implements CustomPacketPayload {
+    public static final Type<BackendHelloPacket> TYPE = new Type<>(
+            Identifier.fromNamespaceAndPath(Constants.MOD_ID, "backend_hello"));
+    public static final StreamCodec<FriendlyByteBuf, BackendHelloPacket> STREAM_CODEC = StreamCodec.of(
+            (buf, packet) -> buf.writeVarInt(packet.version()),
+            buf -> new BackendHelloPacket(buf.readVarInt()));
+
+    @Override
+    public Type<? extends CustomPacketPayload> type() { return TYPE; }
+}
